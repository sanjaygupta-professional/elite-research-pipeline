---
interface Props {
  kicker?: string;
}

const { kicker = "This week's thesis" } = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <span class="t-label hero__kicker">{kicker}</span>
    <hr class="cinnabar-rule cinnabar-rule--lg" aria-hidden="true" />
    <h1 class="t-display hero__thesis">
      <slot />
    </h1>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-step);
    padding-bottom: var(--space-major);
  }

  .hero__inner {
    /* No outer width clamp; the thesis itself sets its measure per
       breakpoint. The kicker and rule align to the left edge of
       whatever width the thesis takes, so the asymmetric mark and
       the display type read as a single anchored unit. */
    display: flex;
    flex-direction: column;
    gap: var(--space-rest);
  }

  .hero__kicker {
    color: var(--color-mute);
  }

  .hero__thesis {
    /* Display type carries the argument. One per page (per The
       One-Display-Per-View Rule). Pulled back ~22% from the base
       --type-display so the masthead can carry more visual weight
       while the thesis stays the single dominant element. The measure
       widens in step with the smaller type so the block keeps its
       3-5 confident lines rather than turning into a tall column. */
    font-size: clamp(1.65rem, 2.6vw + 0.95rem, 2.9rem);
    max-width: 22ch;
  }

  @media (min-width: 720px) {
    .hero__thesis {
      max-width: 32ch;
    }
  }

  @media (min-width: 1100px) {
    .hero__thesis {
      max-width: 46ch;
    }
  }

  @media (min-width: 1400px) {
    .hero__thesis {
      max-width: 54ch;
    }
  }
</style>
