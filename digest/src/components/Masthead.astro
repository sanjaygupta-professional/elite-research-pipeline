---
import { KS_HOME_URL } from "../config";

interface Props {
  issueDate: string; // e.g. "2026-04-27"
  scanNumber: number;
  signalCount: number;
  strongCount: number;
  weakCount: number;
  homeUrl?: string; // link back to the main publication site
}

const {
  issueDate,
  scanNumber,
  signalCount,
  strongCount,
  weakCount,
  homeUrl = KS_HOME_URL,
} = Astro.props;
---

<header class="masthead">
  <a class="masthead__wordmark" href={homeUrl}>
    Possibilities with Probabilities
  </a>
  <span class="masthead__dispatch t-label">Weekly Dispatch</span>

  <hr class="cinnabar-rule masthead__rule" aria-hidden="true" />

  <div class="masthead__meta-row">
    <time class="masthead__date" datetime={issueDate}>{issueDate}</time>
    <span class="masthead__sep" aria-hidden="true">·</span>
    <span class="masthead__meta">Scan №{scanNumber}</span>
    <span class="masthead__sep" aria-hidden="true">·</span>
    <span class="masthead__meta">
      {signalCount} signals
      <span class="masthead__sub">({strongCount} strong · {weakCount} weak)</span>
    </span>
  </div>
</header>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-tight);
    padding-bottom: var(--space-rest);
    margin-bottom: var(--space-section);
  }

  /* The wordmark is now the masthead's anchor: a bold Geist Mono block,
     stepped up from the old tiny label — confident, but capped at 2rem so
     it stays clearly subordinate to the ~2.9rem thesis (One-Display-Per-View). */
  .masthead__wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.4vw + 1.05rem, 2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .masthead__wordmark:hover {
    color: var(--color-cinnabar);
  }

  .masthead__dispatch {
    /* t-label carries the mono / uppercase / muted treatment. */
    display: block;
  }

  /* The signature asymmetric cinnabar mark, tying the masthead into the
     page's visual system. */
  .masthead__rule {
    margin: var(--space-snug) 0 var(--space-tight);
  }

  .masthead__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.7em;
    row-gap: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--type-mono-title);
    line-height: var(--leading-mono);
    letter-spacing: 0.005em;
  }

  .masthead__date {
    color: var(--color-ink);
    font-feature-settings: "tnum";
  }

  .masthead__meta {
    color: var(--color-mute);
  }

  .masthead__sep {
    color: var(--color-hairline);
    user-select: none;
  }

  .masthead__sub {
    color: var(--color-mute);
    margin-left: 0.2em;
  }
</style>
