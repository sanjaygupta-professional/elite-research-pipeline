---
// SignalIndex — the scannable "Signals this week" list near the top of the
// dispatch (backbone A). Gives a between-meetings reader a skim path: each row
// is the signal number, its fingerprint glyph, the one-line title, and a
// strong/weak chip, linked to the full detail below (#signal-N).
//
// Driven by the same `signals` metadata array the detail blocks spread from,
// so there is one source of truth and no drift.
import SignalProfile from "./SignalProfile.astro";

interface SignalMeta {
  index: number;
  title: string;
  profile: string;
  strength: "strong" | "weak";
}

interface Props {
  signals: SignalMeta[];
}

const { signals } = Astro.props;
---

{
  signals.length > 0 && (
    <nav class="sigindex" aria-labelledby="sigindex-heading">
      <h2 id="sigindex-heading" class="sigindex__heading t-label">
        Signals this week
      </h2>
      <ol class="sigindex__list">
        {signals.map((s) => (
          <li class="sigindex__item">
            <a class="sigindex__link" href={`#signal-${s.index}`}>
              <span class="sigindex__num t-mono">
                {s.index.toString().padStart(2, "0")}
              </span>
              <span class="sigindex__glyph">
                <SignalProfile profile={s.profile} variant="glyph" />
              </span>
              <span class="sigindex__title">{s.title}</span>
              <span class="sigindex__chip" data-strength={s.strength}>
                {s.strength === "strong" ? "Strong" : "Weak"}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .sigindex {
    margin-block: var(--space-section);
  }

  .sigindex__heading {
    margin: 0 0 var(--space-step) 0;
  }

  .sigindex__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .sigindex__link {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    column-gap: clamp(0.9rem, 2vw, 1.6rem);
    row-gap: 0.5rem;
    padding-block: var(--space-step);
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .sigindex__item:first-child .sigindex__link {
    border-top: 1px solid var(--color-ink);
  }

  .sigindex__link:hover {
    color: var(--color-cinnabar-text);
  }

  .sigindex__num {
    color: var(--color-cinnabar-text);
    font-weight: 500;
    font-feature-settings: "tnum";
    font-size: clamp(1.1rem, 0.6vw + 0.95rem, 1.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    align-self: start;
  }

  .sigindex__glyph {
    align-self: center;
  }

  .sigindex__title {
    font-family: var(--font-body);
    font-size: var(--type-body);
    line-height: 1.4;
    min-width: 0;
    /* Full title stays in the DOM for assistive tech and the detail block;
       the index clamps the display to keep the list scannable. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sigindex__chip {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    border: 1px solid currentColor;
    border-radius: 1px;
    line-height: 1;
    align-self: start;
    white-space: nowrap;
  }

  .sigindex__chip[data-strength="strong"] {
    color: var(--color-cinnabar-text);
  }

  .sigindex__chip[data-strength="weak"] {
    color: var(--color-mute);
  }

  /* On narrow screens the long title needs the full width. Drop it to a
     second row spanning under the number and glyph. */
  @media (max-width: 640px) {
    .sigindex__link {
      grid-template-columns: auto 1fr auto;
    }
    .sigindex__glyph {
      grid-row: 1;
      grid-column: 2;
      justify-self: start;
    }
    .sigindex__title {
      grid-row: 2;
      grid-column: 1 / -1;
      -webkit-line-clamp: 3;
    }
    .sigindex__chip {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
