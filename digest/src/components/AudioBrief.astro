---
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  audioPath: string | null | undefined;
  issueDate?: string;
  voiceAttribution?: string;
  durationFallback?: string;
}

const {
  audioPath,
  issueDate,
  voiceAttribution = "Sanjay's Summary",
  durationFallback = "",
} = Astro.props;

// Conditional render. If no audio file exists, renders nothing.
const hasAudio = !!audioPath;
const avatarSrc = `${import.meta.env.BASE_URL}sanjay.png`;

// Transcript: the spoken script, surfaced as text. Satisfies WCAG 1.2.1
// (text alternative for prerecorded audio), works in open-plan offices, and
// gives shareable quotes. Read at build time; degrades to no transcript if the
// script file is absent. Same build-time fs pattern as PreviousIssues.
let transcriptParas: string[] = [];
if (issueDate) {
  try {
    const raw = readFileSync(
      join(process.cwd(), "audio-scripts", `${issueDate}.md`),
      "utf8",
    );
    transcriptParas = raw
      .trim()
      .split(/\n\s*\n/)
      .map((p) => p.replace(/\s+/g, " ").trim())
      .filter(Boolean);
  } catch {
    transcriptParas = [];
  }
}
---

{
  hasAudio && (
    <section class="audio-brief" data-audio-brief aria-labelledby="audio-brief-heading">
      <h2 id="audio-brief-heading" class="visually-hidden">
        Audio brief
      </h2>
      <img class="audio-brief__avatar" src={avatarSrc} alt="" />
      <button
        type="button"
        class="audio-brief__play"
        aria-label="Play audio brief"
        data-audio-play
      >
        <span class="audio-brief__icon" aria-hidden="true" data-audio-icon>▶</span>
      </button>
      <div class="audio-brief__meta">
        <span class="t-mono audio-brief__time" data-audio-time>{durationFallback}</span>
        <span class="t-mono audio-brief__voice">{voiceAttribution}</span>
      </div>
      <div class="audio-brief__progress" aria-hidden="true">
        <div class="audio-brief__progress-fill" data-audio-progress />
      </div>
      <audio
        class="audio-brief__audio"
        src={audioPath}
        preload="metadata"
        data-audio-element
      />
      {transcriptParas.length > 0 && (
        <details class="audio-brief__transcript">
          <summary class="audio-brief__transcript-summary t-label">
            Read the transcript
          </summary>
          <div class="audio-brief__transcript-body">
            {transcriptParas.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </details>
      )}
    </section>
  )
}

<script>
  // One handler per AudioBrief instance on the page.
  // Each instance is fully independent — pausing one does not affect another.
  document.querySelectorAll<HTMLElement>("[data-audio-brief]").forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>("[data-audio-element]");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-audio-play]");
    const icon = root.querySelector<HTMLElement>("[data-audio-icon]");
    const timeEl = root.querySelector<HTMLElement>("[data-audio-time]");
    const progressEl = root.querySelector<HTMLElement>("[data-audio-progress]");

    if (!audio || !playBtn || !icon || !timeEl || !progressEl) return;

    const formatTime = (seconds: number): string => {
      if (!isFinite(seconds) || seconds < 0) return "0:00";
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, "0")}`;
    };

    // Show duration as soon as metadata loads.
    audio.addEventListener("loadedmetadata", () => {
      timeEl.textContent = formatTime(audio.duration);
    });

    // While playing, show elapsed and update progress bar.
    audio.addEventListener("timeupdate", () => {
      if (audio.duration > 0) {
        const pct = (audio.currentTime / audio.duration) * 100;
        progressEl.style.width = `${pct}%`;
      }
    });

    audio.addEventListener("ended", () => {
      icon.textContent = "▶";
      playBtn.setAttribute("aria-label", "Play audio brief");
      progressEl.style.width = "0%";
      timeEl.textContent = formatTime(audio.duration);
    });

    audio.addEventListener("play", () => {
      icon.textContent = "❚❚";
      playBtn.setAttribute("aria-label", "Pause audio brief");
    });

    audio.addEventListener("pause", () => {
      // Only swap back if we're not at the end (handled by 'ended').
      if (!audio.ended) {
        icon.textContent = "▶";
        playBtn.setAttribute("aria-label", "Play audio brief");
      }
    });

    playBtn.addEventListener("click", () => {
      if (audio.paused) {
        audio.play().catch(() => {
          // Autoplay or load error. Keep UI in paused state.
        });
      } else {
        audio.pause();
      }
    });
  });
</script>

<style>
  /* AudioBrief: cinnabar play affordance + audit-trail metadata.
     Sits between HeroThesis and Synthesis on the dispatch page.
     Top + bottom hairline rules — matches the Signal "watch" callout
     pattern. The progress bar replaces the bottom hairline with a
     cinnabar fill as the audio plays. No card, no shadow. */

  .audio-brief {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    column-gap: var(--space-step);
    row-gap: var(--space-snug);
    padding-top: var(--space-step);
    padding-bottom: var(--space-step);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
    margin-top: var(--space-rest);
    margin-bottom: var(--space-rest);
    max-width: var(--measure-prose);
    position: relative;
  }

  /* ── Avatar ────────────────────────────────────────────────────── */
  .audio-brief__avatar {
    width: 2.6rem;
    height: 2.6rem;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }

  /* ── Play button ───────────────────────────────────────────────── */
  .audio-brief__play {
    grid-row: span 1;
    appearance: none;
    border: 1px solid var(--color-cinnabar);
    background: transparent;
    color: var(--color-cinnabar);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0; /* sharp corners — DESIGN.md component philosophy */
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .audio-brief__play:hover {
    background-color: var(--color-cinnabar);
    color: var(--color-cream);
  }

  /* Focus ring consistent with every other interactive element on the page. */
  .audio-brief__play:focus-visible {
    outline: 2px solid var(--color-cinnabar);
    outline-offset: 3px;
  }

  .audio-brief__play:active {
    transform: translateY(1px);
  }

  .audio-brief__icon {
    font-feature-settings: "ss01";
    /* Pause symbol is two thin bars; play is a triangle. The font's
       default rendering of "▶" leans slightly off-center — nudge. */
    transform: translateX(0.05em);
  }

  /* ── Meta row ──────────────────────────────────────────────────── */
  .audio-brief__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.85em;
    row-gap: 0.25em;
    color: var(--color-mute);
  }

  .audio-brief__label {
    color: var(--color-cinnabar);
  }

  .audio-brief__time {
    color: var(--color-ink);
    font-feature-settings: "tnum";
    font-weight: 500;
  }

  .audio-brief__voice {
    color: var(--color-mute);
  }

  /* ── Progress bar (replaces the bottom hairline as it fills) ───── */
  .audio-brief__progress {
    grid-column: 1 / -1;
    position: absolute;
    bottom: -1px; /* sits over the bottom border */
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
  }

  .audio-brief__progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-cinnabar);
    transition: width 0.1s linear;
  }

  /* Hidden native element. The button + progress is the visual UI. */
  .audio-brief__audio {
    display: none;
  }

  /* ── Transcript (text alternative) ─────────────────────────────── */
  .audio-brief__transcript {
    grid-column: 1 / -1;
  }

  .audio-brief__transcript-summary {
    cursor: pointer;
    color: var(--color-cinnabar-text);
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.2em;
    user-select: none;
  }

  .audio-brief__transcript-summary::-webkit-details-marker {
    display: none;
  }

  .audio-brief__transcript-summary::before {
    content: "+";
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .audio-brief__transcript[open] .audio-brief__transcript-summary::before {
    content: "–";
  }

  .audio-brief__transcript-summary:focus-visible {
    outline: 2px solid var(--color-cinnabar);
    outline-offset: 3px;
  }

  .audio-brief__transcript-body {
    margin-top: var(--space-step);
    max-width: var(--measure-prose);
  }

  .audio-brief__transcript-body :global(p) {
    margin-bottom: var(--space-step);
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .audio-brief__transcript-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ── Mobile ────────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .audio-brief__meta {
      column-gap: 0.6em;
    }
  }
</style>
