---
interface Props {
  kicker?: string;
}

const { kicker = "Cluster pattern" } = Astro.props;
---

<aside class="cluster" aria-labelledby="cluster-heading">
  <div class="cluster__inner measure-wide">
    <h2 id="cluster-heading" class="t-label cluster__kicker">{kicker}</h2>
    <hr class="cinnabar-rule" aria-hidden="true" />
    <div class="cluster__body t-body">
      <slot />
    </div>
  </div>
</aside>

<style>
  /* The cluster callout is the page's moment of synthesis insight.
     Inverted (deep ink on cream) to make it the unmissable reading
     beat: dark surface, cream type, cinnabar rule. The single
     inverted block in the entire layout. */
  .cluster {
    padding-block: var(--space-major);
    margin-block: var(--space-major);
    background-color: var(--color-ink);
    color: var(--color-cream);
    margin-inline: calc(-1 * clamp(1.25rem, 5vw, 3rem));
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .cluster__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-step);
  }

  /* Cinnabar text on this block follows --color-cinnabar-text, whose value is
     set per-theme in global.css: light theme = the block is ink (dark), so the
     lighter cinnabar; dark theme = the block auto-inverts to cream (light), so
     the deeper cinnabar. Either way it clears WCAG AA. */
  .cluster__kicker {
    color: var(--color-cinnabar-text);
    margin: 0;
  }

  .cluster :global(.cinnabar-rule) {
    width: var(--rule-length-large);
  }

  .cluster__body {
    max-width: var(--measure-prose);
    font-size: clamp(1.2rem, 0.5vw + 1rem, 1.5rem);
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-cream);
    font-family: var(--font-display);
    letter-spacing: -0.005em;
  }

  .cluster__body :global(p) {
    margin: 0;
  }

  .cluster__body :global(strong) {
    color: var(--color-cinnabar-text);
    font-weight: 600;
  }
</style>
