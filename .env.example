# Copy to .env (gitignored) and fill in real values.
# .env.example is committed; .env is not.

GEMINI_API_KEY=

# ElevenLabs — cloned voice TTS for Cinnabar Dispatch + category audio briefs.
# Get API key:  https://elevenlabs.io/app/settings/api-keys
# Get voice ID: Voice Lab → your cloned voice → "ID" button (32-char string)
# Plan tier:    Creator+ required for cloned voices and eleven_v3 model
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STABILITY=0.6
ELEVENLABS_SIMILARITY=0.85
